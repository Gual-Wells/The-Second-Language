  "intention": "A slender parchment seam joined with returning brick-red stitches; a private project keepsake about a visible connection and the room left for words. No inference about the recipient's personal history or an examination event.",
  "copy": {
    "institution": "The Second Language",
    "artTitle": "The Returning Thread",
    "verse": [
      "The thread enters the parchment",
      "and passes out of sight.",
      "A little farther on, it returns.",
      "The seam holds the page;",
      "the page keeps room for words."
    ],
    "colophon": [
      "Made for Gual Wells,",
      "in remembrance of The Second Language."
    ],
    "sealLegends": [
      "The Second Language",
      "In remembrance"
    ],
    "status": "Private commemorative work",
    "translation": {
      "institution": "第二语言",
      "artTitle": "回返的线",
      "verse": [
        "细线穿入羊皮纸，",
        "从眼前隐去。",
        "再往前一点，它便回返。",
        "缝线维系着纸页；",
        "纸页为言语留着空处。"
      ],
      "colophon": [
        "为 Gual Wells 而作，",
        "以纪念《第二语言》。"
      ],
      "sealLegends": [
