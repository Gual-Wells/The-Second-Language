    "title": "河谷里未说完的话"
  },
  "intention": "芦管承载声音、旧墨保存手迹、种子保留来季；以一幅横向小画与居中双节题辞共同表现河谷的留存与继续。",
  "copy": {
    "artTitle": "Of Leaf and Letter",
    "artTitleLines": [
      "Of Leaf",
      "and Letter"
    ],
    "chapterEnglishTitle": "Words Unfinished in the Valley",
    "stanzas": [
      [
        "A reed gives breath a voice.",
        "Old ink outlives the hand."
      ],
      [
        "A seed lies in the fold,",
        "holding a season yet to come."
      ]
    ],
    "translation": {
      "artTitle": "叶与书简",
      "chapterEnglishTitle": "河谷里未说完的话",
      "stanzas": [
        [
          "芦管赋予气息以声音。",
          "旧墨长存，落笔的手已成往昔。"
        ],
        [
          "一粒种子卧于折页之间，",
          "怀抱着尚未来临的季节。"
        ]
      ]
    }
  },
