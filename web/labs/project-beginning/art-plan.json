  "intention": "A private remembrance of the project beginning: words enter ordinary life through context and response, then page follows page. This draft makes no claim about a founding date, the recipient's personal experience or an examination event.",
  "copy": {
    "rubric": "A project remembrance",
    "institution": "The Second Language",
    "artTitle": "A Day in Another Tongue",
    "verse": [
      "With a first word, the work begins:",
      "rain at the shutter, bread upon the board,",
      "a greeting answered at an open door.",
      "Page will follow page.",
      "Another tongue enters the day."
    ],
    "colophon": [
      "For Gual Wells,",
      "to mark the beginning of The Second Language."
    ],
    "sealLegends": [
      "The Second Language",
      "In remembrance"
    ],
    "status": "Private commemorative work",
    "translation": {
      "rubric": "项目特别留念",
      "institution": "第二语言",
      "artTitle": "另一种语言里的一日",
      "verse": [
        "这项工作，始于第一个词：",
        "窗板边的雨，木案上的面包，",
        "敞开的门口，一声招呼有了回应。",
        "一页之后，还将有一页。",
        "另一种语言，走进这一日。"
      ],
      "colophon": [
        "为 Gual Wells 而作，",
        "纪念《第二语言》的启程。"
      ],
      "sealLegends": [
        "第二语言",
        "留作纪念"
      ],
      "status": "私人纪念作品"
